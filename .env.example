# Invoicing environment variables

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Invoicing admin access (required)
INVOICING_ADMIN_PASSWORD=choose-a-strong-password

# Optional: separate signing secret for invoicing sessions
INVOICING_SESSION_SECRET=random-long-secret

# Invoice payment methods (comma-separated). ACH is listed first to prefer bank debit.
# Set to "dashboard" to use Stripe Billing invoice defaults instead.
INVOICING_PAYMENT_METHODS=us_bank_account,card

# Existing contact form
RESEND_API_KEY=
CONTACT_TO_EMAIL=media@8thandexchange.com
CONTACT_FROM_EMAIL=8th & Exchange Media <hello@8thandexchange.com>

# Client portal (Supabase project: 8th-exchange-media)
SUPABASE_URL=https://ouhrjtedtrduzccdlieb.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional: separate signing secret for portal sessions (falls back to INVOICING_SESSION_SECRET)
PORTAL_SESSION_SECRET=

# Go High Level (LeadConnector) — the AGENCY's own sub-account:
# Private Integration token + location id. Used for 8emedia.com lead capture
# and for posting as 8E Media in the Social Planner.
# Client sub-accounts are NOT env vars: connect each client's location id +
# token on their client page (/invoicing/clients/<id>), stored in Supabase.
GHL_API_TOKEN=pit-xxx
GHL_LOCATION_ID=

# Consent-gated analytics — banner appears only when at least one id is set
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Meta ads (agency / 8emedia.com). Create the Pixel in Events Manager first —
# there is no ID until you do. Staff walkthrough: /invoicing/ads
# NEXT_PUBLIC_META_PIXEL_ID is the Dataset ID (browser Pixel).
META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
META_PAGE_ID=
# System User token with ads_read (CAPI tokens usually cannot list campaigns)
META_ADS_ACCESS_TOKEN=
# Optional: Events Manager → Test events code (keeps CAPI tests out of reporting)
META_PIXEL_TEST_EVENT_CODE=
# Domain verification string from Business settings → Brand safety → Domains
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
